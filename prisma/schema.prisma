generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  UTILISATEUR
  ADMIN
  SUPER_ADMIN
}

enum StatutCompte {
  EN_ATTENTE
  VALIDE
  REJETE
  BLOQUE
}

enum StatutEpreuve {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

enum Niveau {
  LICENCE_1
  LICENCE_2
  LICENCE_3
  MASTER_1
  MASTER_2
  CONCOURS
  EXAMEN_NATIONAL
}

enum TypeDocument {
  EPREUVE
  COURS
  EXERCICE
  EXAMEN
  CONCOURS
}

model User {
  id                String        @id @default(cuid())
  nom               String
  email             String        @unique
  motDePasse        String
  role              Role          @default(UTILISATEUR)
  statutCompte      StatutCompte  @default(EN_ATTENTE)
  motifRejet        String?
  filiere           String?
  tokenReset        String?
  tokenResetExpire  DateTime?
  epreuves          Epreuve[]
  createdAt         DateTime      @default(now())
}

model Epreuve {
  id          String         @id @default(cuid())
  titre       String
  type        TypeDocument   @default(EPREUVE)
  niveau      Niveau
  filiere     String?
  matiere     String
  annee       Int
  fichierUrl  String
  statut      StatutEpreuve  @default(EN_ATTENTE)
  motifRejet  String?
  auteur      User           @relation(fields: [auteurId], references: [id])
  auteurId    String
  createdAt   DateTime       @default(now())
}
